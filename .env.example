# ELIXENT — Environment Configuration Reference
# Copy this file to `.env.local` or `.env` and fill in real values. NEVER commit secret keys.

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# ---------------------------------------------------------------------------
# Production: Neon / any Postgres provider. Test suite uses an isolated
# Neon branch (see "Isolated Test Database" below + drizzle.config.test.ts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ---------------------------------------------------------------------------
# Isolated Test Database (Neon Branch — Phase 10) — MANDATORY for tests
# ---------------------------------------------------------------------------
# Integration tests MUST run on a dedicated Neon branch, NEVER on the app's
# main/production branch. Create the branch once:
#
#   neonctl branches create --name test-suite --project-id <PROJECT_ID>
#   neonctl connection-string <BRANCH_ID> --project-id <PROJECT_ID> --pooled
#
# Then put the resulting URL in `.env.test.local` (git-ignored, NOT committed):
#
#   TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.aws.neon.tech/neondb?sslmode=require
#
# Apply the schema to the branch after every change under src/lib/db:
#
#   npx drizzle-kit push --config drizzle.config.test.ts
#
# Optional denylist: hosts that must never be booted by the test guard
# (defense-in-depth against pasting the main-branch URL as TEST_DATABASE_URL):
#   TEST_DB_FORBIDDEN_HOSTS=ep-main-branch-host.neon.tech
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Supabase (Authentication)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key for administrative operations (Keep secret):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# ---------------------------------------------------------------------------
# API Keys (Live keys use sk_live_/pk_live_/whsec_live_ prefixes):
STRIPE_SECRET_KEY=sk_test_x
STRIPE_WEBHOOK_SECRET=whsec_x
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_x

# Stripe Price IDs for Subscription Tiers (Created in Stripe Dashboard):
# Pro Tier ($12/month recurring):
STRIPE_PRO_PRICE_ID=price_x
# Ultra Tier ($120/month recurring):
STRIPE_ULTRA_PRICE_ID=price_x

# ---------------------------------------------------------------------------
# Gemini AI Key Rotation (src/lib/ai/key-rotation.ts)
# ---------------------------------------------------------------------------
# Up to 10 Gemini API keys for seamless automatic key rotation & rate-limit avoidance:
GEMINI_KEY_1=AIza_x
GEMINI_KEY_2=AIza_y
# Optional additional keys:
# GEMINI_KEY_3=AIza_z
# GEMINI_KEY_4=...
# GEMINI_KEY_5=...
# GEMINI_KEY_6=...
# GEMINI_KEY_7=...
# GEMINI_KEY_8=...
# GEMINI_KEY_9=...
# GEMINI_KEY_10=...

# Maximum requests per key before rotating to the next key (default: 20):
GEMINI_REQUESTS_PER_KEY=20

# ---------------------------------------------------------------------------
# Upstash Redis (Rate limiting + AI key rotation counters)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-app.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ---------------------------------------------------------------------------
# Cron jobs (purge-deleted retention + quota reset)
# ---------------------------------------------------------------------------
# REQUIRED: a long random secret shared only with your scheduler.
# The cron route (/api/cron/purge-deleted) rejects any request without it:
#   Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -base64 32
CRON_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Public base URL of your deployment — used by schedulers and auth callbacks
VITE_APP_URL=https://your-app.com

# ---------------------------------------------------------------------------
# Feature Flags (src/config/features.config.ts)
# ---------------------------------------------------------------------------
# Enables/Disables real-time Ephemeral UI AI Streaming in the Markdown editor.
# - true: Activates modern ephemeral ghost streaming, in-editor live widget, 
#         AIStreamStatus alerts, and atomic single-transaction commit (Ctrl+Z).
# - false: Fallbacks to the standard snapshot/buffered path.
VITE_AI_STREAMING_ENABLED=true

# ---------------------------------------------------------------------------
# Cron scheduling reference
# ---------------------------------------------------------------------------
# Option A — External HTTP Scheduler Cron (e.g. cron-job.org, Cloudflare Cron Triggers, system crontab):
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#        https://$VITE_APP_URL/api/cron/purge-deleted
# Option B — GitHub Actions schedule (see .github/workflows/cron.yml):
#   Runs daily at 03:00 UTC via the workflow file in this repository.
# Recommended cadence: daily. Each run deletes at most 500 rows, so the
# endpoint is safe to call more often during catch-up purges.
